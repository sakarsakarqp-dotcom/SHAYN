# SHAYN environment configuration
# Never commit real credentials. Set these in your hosting provider's secret environment.
NODE_ENV=production
PORT=3000

# Supabase PostgreSQL connection string (use the server-side connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Leave unset for the default production TLS configuration; set false only for local non-TLS databases.
DATABASE_SSL=

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Initial administrator account. Use a strong password and store it only in hosting secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=replace-with-a-unique-14-character-password
