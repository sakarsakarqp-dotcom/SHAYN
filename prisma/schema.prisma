generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shayn"]
}

model User {
  id                 BigInt                    @id @default(autoincrement())
  name               String                    @db.VarChar(120)
  email              String                    @unique @db.VarChar(255)
  passwordHash       String                    @map("password_hash")
  role               String                    @default("user") @db.VarChar(20)
  bio                String?
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  listings           Listing[]
  applications      Application[]
  sentMessages       Message[]                 @relation("MessageSender")
  receivedMessages   Message[]                 @relation("MessageRecipient")
  reviewsGiven       Review[]                  @relation("ReviewReviewer")
  reviewsReceived    Review[]                  @relation("ReviewSubject")
  reports            Report[]                   @relation("ReportReporter")
  reportsAgainst     Report[]                   @relation("ReportSubject")
  buyerOrders        Order[]                   @relation("OrderBuyer")
  sellerOrders       Order[]                   @relation("OrderSeller")
  roles              UserRole[]
  ownedOrganizations Organization[]            @relation("OrganizationOwner")
  memberships        OrganizationMembership[]
  membershipsInvited OrganizationMembership[]  @relation("MembershipInviter")
  invitationsCreated OrganizationInvitation[]  @relation("InvitationCreator")
  invitationsAccepted OrganizationInvitation[] @relation("InvitationAcceptor")
  auditActions       OrganizationAuditLog[]    @relation("OrganizationAuditActor")
  auditTargets       OrganizationAuditLog[]    @relation("OrganizationAuditTarget")

  @@map("users")
  @@schema("shayn")
}

model Listing {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt        @map("user_id")
  type         String        @db.VarChar(20)
  title        String        @db.VarChar(180)
  description  String
  category     String?       @db.VarChar(120)
  price        Decimal?      @db.Decimal(12, 2)
  currency     String?       @default("USD") @db.VarChar(8)
  location     String?       @db.VarChar(160)
  status       String        @default("active") @db.VarChar(20)
  imageUrl     String?       @map("image_url")
  entityName   String?       @map("entity_name") @db.VarChar(160)
  entityKind   String?       @map("entity_kind") @db.VarChar(32)
  website      String?       @db.VarChar(300)
  contactPhone String?       @map("contact_phone") @db.VarChar(40)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  messages     Message[]
  reports      Report[]
  orderItems   OrderItem[]

  @@index([type, status, createdAt(sort: Desc)], map: "listings_type_status_created_idx")
  @@index([userId], map: "listings_user_idx")
  @@map("listings")
  @@schema("shayn")
}

model Application {
  id        BigInt   @id @default(autoincrement())
  listingId BigInt   @map("listing_id")
  userId    BigInt   @map("user_id")
  message   String?
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@map("applications")
  @@schema("shayn")
}

model Message {
  id          BigInt    @id @default(autoincrement())
  senderId    BigInt    @map("sender_id")
  recipientId BigInt    @map("recipient_id")
  listingId   BigInt?   @map("listing_id")
  body        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  listing     Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([senderId, recipientId, createdAt(sort: Desc)], map: "messages_pair_idx")
  @@map("messages")
  @@schema("shayn")
}

model Review {
  id             BigInt   @id @default(autoincrement())
  reviewerId     BigInt   @map("reviewer_id")
  reviewedUserId BigInt   @map("reviewed_user_id")
  rating         Int      @db.SmallInt
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewer       User     @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  subject        User     @relation("ReviewSubject", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@schema("shayn")
}

model Report {
  id             BigInt    @id @default(autoincrement())
  reporterId     BigInt    @map("reporter_id")
  listingId      BigInt?   @map("listing_id")
  reportedUserId BigInt?   @map("reported_user_id")
  reason         String
  status         String    @default("open") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reporter       User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?     @relation("ReportSubject", fields: [reportedUserId], references: [id], onDelete: Cascade)
  listing        Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("reports")
  @@schema("shayn")
}

model Order {
  id              BigInt      @id @default(autoincrement())
  buyerId         BigInt      @map("buyer_id")
  sellerId        BigInt      @map("seller_id")
  buyerName       String      @map("buyer_name") @db.VarChar(120)
  buyerPhone      String      @map("buyer_phone") @db.VarChar(40)
  deliveryAddress String      @map("delivery_address")
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @default("USD") @db.VarChar(8)
  status          String      @default("pending") @db.VarChar(20)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  buyer           User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller          User        @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  items           OrderItem[]

  @@index([buyerId, createdAt(sort: Desc)], map: "orders_buyer_created_idx")
  @@index([sellerId, createdAt(sort: Desc)], map: "orders_seller_created_idx")
  @@map("orders")
  @@schema("shayn")
}

model OrderItem {
  id          BigInt   @id @default(autoincrement())
  orderId     BigInt   @map("order_id")
  listingId   BigInt?  @map("listing_id")
  productTitle String @map("product_title") @db.VarChar(180)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "order_items_order_idx")
  @@map("order_items")
  @@schema("shayn")
}

model UserRole {
  userId    BigInt   @map("user_id")
  role      String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role, createdAt(sort: Desc)], map: "user_roles_role_created_idx")
  @@map("user_roles")
  @@schema("shayn")
}

model Organization {
  id          BigInt                    @id @default(autoincrement())
  name        String                    @db.VarChar(160)
  slug        String                    @unique @db.VarChar(160)
  kind        String                    @default("company") @db.VarChar(32)
  description String?
  countryCode String                    @default("SY") @map("country_code") @db.Char(2)
  ownerUserId BigInt                    @map("owner_user_id")
  status      String                    @default("pending") @db.VarChar(20)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner       User                      @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  auditLogs   OrganizationAuditLog[]

  @@index([ownerUserId, createdAt(sort: Desc)], map: "organizations_owner_created_idx")
  @@index([status, createdAt(sort: Desc)], map: "organizations_status_created_idx")
  @@map("organizations")
  @@schema("shayn")
}

model OrganizationMembership {
  organizationId BigInt       @map("organization_id")
  userId         BigInt       @map("user_id")
  role           String       @db.VarChar(32)
  status         String       @default("active") @db.VarChar(20)
  invitedByUserId BigInt?     @map("invited_by_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@id([organizationId, userId])
  @@index([userId, status], map: "organization_memberships_user_status_idx")
  @@index([organizationId, role, status], map: "organization_memberships_org_role_idx")
  @@map("organization_memberships")
  @@schema("shayn")
}

model OrganizationInvitation {
  id                BigInt       @id @default(autoincrement())
  organizationId    BigInt       @map("organization_id")
  email             String       @db.VarChar(255)
  role              String       @db.VarChar(32)
  tokenHash         String       @unique @map("token_hash") @db.VarChar(128)
  status            String       @default("pending") @db.VarChar(20)
  invitedByUserId   BigInt       @map("invited_by_user_id")
  acceptedByUserId  BigInt?      @map("accepted_by_user_id")
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy         User         @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy        User?        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt(sort: Desc)], map: "organization_invitations_org_status_idx")
  @@index([email, status], map: "organization_invitations_email_status_idx")
  @@map("organization_invitations")
  @@schema("shayn")
}

model OrganizationAuditLog {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt       @map("organization_id")
  actorUserId    BigInt?      @map("actor_user_id")
  targetUserId   BigInt?      @map("target_user_id")
  action         String       @db.VarChar(80)
  details        Json         @default("{}") @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("OrganizationAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target         User?        @relation("OrganizationAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)], map: "organization_audit_logs_org_created_idx")
  @@map("organization_audit_logs")
  @@schema("shayn")
}
